---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contacto"
  description="Contacta con iCampuzanos para agendar una asesoría gratuita o resolver cualquier duda sobre nuestros servicios. Respondemos en menos de 48 horas."
>
  <Header />
  <main>
    <!-- Page header -->
    <section class="bg-gradient-to-br from-brand-950 to-brand-700 text-white py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="text-gold-300 font-semibold text-sm uppercase tracking-wider">Contacto</span>
        <h1 class="mt-2 font-serif text-4xl md:text-5xl font-extrabold">
          Hablemos de <br class="hidden sm:block"/>
          <span class="text-gold-300">tu negocio</span>
        </h1>
        <p class="mt-4 text-brand-100 max-w-xl text-lg">
          Primera consulta gratuita. Sin compromiso. Respondemos en menos de 48 horas.
        </p>
      </div>
    </section>

    <!-- Contact section -->
    <section class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-14">

          <!-- Form -->
          <div>
            <h2 class="text-2xl font-extrabold text-gray-900 mb-6">Envíanos un mensaje</h2>
            <form name="contacto" method="POST" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label>
                  <input
                    type="text" id="nombre" name="nombre" required placeholder="Tu nombre"
                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                  <input
                    type="email" id="email" name="email" required placeholder="tu@email.com"
                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition"
                  />
                </div>
              </div>

              <div>
                <label for="empresa" class="block text-sm font-medium text-gray-700 mb-1">Tipo de negocio</label>
                <select id="empresa" name="empresa"
                  class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition bg-white">
                  <option value="">Selecciona una opción</option>
                  <option value="autonomo">Persona física / Freelance</option>
                  <option value="pyme">Pequeña empresa (1–10 empleados)</option>
                  <option value="mediana">Empresa mediana (10–50 empleados)</option>
                  <option value="startup">Startup</option>
                  <option value="otro">Otro</option>
                </select>
              </div>

              <div>
                <label for="servicio" class="block text-sm font-medium text-gray-700 mb-1">¿En qué podemos ayudarte?</label>
                <select id="servicio" name="servicio"
                  class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition bg-white">
                  <option value="">Selecciona un servicio</option>
                  <option value="diagnostico">Diagnóstico financiero</option>
                  <option value="asesoria">Asesoría integral</option>
                  <option value="acompanamiento">Acompañamiento continuo</option>
                  <option value="impuestos">Impuestos / Fiscalidad</option>
                  <option value="contabilidad">Contabilidad</option>
                  <option value="rrhh">Recursos humanos / Nóminas</option>
                  <option value="otro">Otro / No sé aún</option>
                </select>
              </div>

              <div>
                <label for="mensaje" class="block text-sm font-medium text-gray-700 mb-1">Mensaje *</label>
                <textarea id="mensaje" name="mensaje" required rows="4"
                  placeholder="Cuéntanos brevemente tu situación o duda..."
                  class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition resize-none"
                ></textarea>
              </div>

              <div class="flex items-start gap-3">
                <input type="checkbox" id="privacidad" name="privacidad" required
                  class="mt-1 w-4 h-4 accent-gold-500" />
                <label for="privacidad" class="text-sm text-gray-500">
                  He leído y acepto la
                  <a href="/politica-de-privacidad" class="text-gold-600 hover:underline">política de privacidad</a>
                  y el tratamiento de mis datos para recibir respuesta a mi consulta. *
                </label>
              </div>

              <button type="submit"
                class="w-full bg-gold-500 hover:bg-gold-600 text-white font-semibold py-3 rounded-xl transition-colors">
                Enviar mensaje
              </button>
            </form>
          </div>

          <!-- Contact info -->
          <div class="space-y-8">
            <div>
              <h2 class="text-2xl font-extrabold text-gray-900 mb-6">Otros canales</h2>
              <div class="space-y-5">
                <a href="https://wa.me/524493384115" target="_blank" rel="noopener noreferrer"
                  class="flex items-center gap-4 p-5 bg-green-50 border border-green-200 rounded-xl hover:bg-green-100 transition-colors">
                  <div class="w-12 h-12 bg-green-500 rounded-xl flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.553 4.117 1.524 5.853L.057 23.882l6.194-1.625A11.93 11.93 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.882a9.873 9.873 0 01-5.032-1.374l-.361-.214-3.735.979.995-3.638-.235-.374A9.861 9.861 0 012.118 12C2.118 6.533 6.533 2.118 12 2.118S21.882 6.533 21.882 12 17.467 21.882 12 21.882z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-gray-900">WhatsApp</p>
                    <p class="text-sm text-gray-500">+52 449 338 4115</p>
                  </div>
                </a>

                <a href="mailto:info@icampuzanos.com"
                  class="flex items-center gap-4 p-5 bg-brand-50 border border-brand-100 rounded-xl hover:bg-brand-100 transition-colors">
                  <div class="w-12 h-12 bg-brand-700 rounded-xl flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-gray-900">Email</p>
                    <p class="text-sm text-gray-500">info@icampuzanos.com</p>
                  </div>
                </a>
              </div>
            </div>

            <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-3">Horario de atención</h3>
              <div class="space-y-2 text-sm text-gray-500">
                <div class="flex justify-between">
                  <span>Lunes – Viernes</span>
                  <span class="font-medium text-gray-700">9:00 – 18:00</span>
                </div>
                <div class="flex justify-between">
                  <span>Sábado – Domingo</span>
                  <span class="font-medium text-gray-700">Cerrado</span>
                </div>
              </div>
              <p class="mt-4 text-xs text-gray-400">
                Respondemos por email y WhatsApp en un máximo de 48 horas en días hábiles.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
