---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import WhyUs from '../components/WhyUs.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<BaseLayout
  title="iCampuzanos — Asesoría fiscal y contable en México"
  description="Asesoría en impuestos, contabilidad, finanzas y recursos humanos para emprendedores y pequeñas empresas en México. Sin tecnicismos. Con resultados."
>
  <Header />
  <main>
    <Hero />
    <Services />
    <WhyUs />
    <ContactCTA />
  </main>
  <Footer />
</BaseLayout>
