---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    slug: 'como-reducir-tu-factura-fiscal',
    title: 'Cómo reducir tu factura fiscal siendo persona física en 2025',
    excerpt: 'Descubre las deducciones fiscales más comunes que los autónomos olvidan aplicar y que pueden suponer un ahorro significativo en tu declaración anual.',
    date: '2025-03-10',
    category: 'Fiscalidad',
    readTime: '5 min',
  },
  {
    slug: 'persona-fisica-vs-moral',
    title: '¿Persona física o moral? Cómo elegir la forma jurídica correcta',
    excerpt: 'Una de las decisiones más importantes al emprender. Te explicamos los pros y contras de cada opción según tu situación y volumen de facturación.',
    date: '2025-02-20',
    category: 'Emprendimiento',
    readTime: '7 min',
  },
  {
    slug: 'contabilidad-basica-pyme',
    title: 'Contabilidad básica que todo dueño de negocio debería entender',
    excerpt: 'No hace falta ser contador para entender el balance, el estado de resultados y el flujo de caja. Te lo explicamos con ejemplos reales.',
    date: '2025-01-15',
    category: 'Contabilidad',
    readTime: '6 min',
  },
];
---

<BaseLayout
  title="Blog"
  description="Artículos sobre fiscalidad, contabilidad, finanzas y emprendimiento. Escritos en lenguaje claro para emprendedores y pymes en México."
>
  <Header />
  <main>
    <!-- Page header -->
    <section class="bg-gradient-to-br from-brand-950 to-brand-700 text-white py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="text-gold-300 font-semibold text-sm uppercase tracking-wider">Blog</span>
        <h1 class="mt-2 font-serif text-4xl md:text-5xl font-extrabold">
          Finanzas claras, <br class="hidden sm:block"/>
          <span class="text-gold-300">decisiones mejores</span>
        </h1>
        <p class="mt-4 text-brand-100 max-w-xl text-lg">
          Artículos prácticos sobre fiscalidad, contabilidad y emprendimiento.
          Sin jerga, con ejemplos reales.
        </p>
      </div>
    </section>

    <!-- Posts grid -->
    <section class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <article class="group bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:border-brand-200 transition-all">
              <div class="bg-brand-50 h-40 flex items-center justify-center">
                <span class="text-5xl">📝</span>
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-xs font-semibold text-gold-700 bg-gold-50 px-2 py-1 rounded-full">
                    {post.category}
                  </span>
                  <span class="text-xs text-gray-400">{post.readTime} lectura</span>
                </div>
                <h2 class="font-bold text-gray-900 text-lg mb-2 group-hover:text-brand-700 transition-colors leading-snug">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h2>
                <p class="text-sm text-gray-500 leading-relaxed mb-4">{post.excerpt}</p>
                <div class="flex items-center justify-between">
                  <time class="text-xs text-gray-400">
                    {new Date(post.date).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  <a href={`/blog/${post.slug}`}
                    class="text-gold-600 text-sm font-semibold hover:text-gold-700 flex items-center gap-1">
                    Leer
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-14 text-center bg-brand-50 rounded-2xl p-10">
          <p class="text-2xl mb-2">✍️</p>
          <h3 class="font-bold text-gray-900 mb-2">Más artículos en camino</h3>
          <p class="text-gray-500 text-sm max-w-md mx-auto">
            Publicamos nuevo contenido cada semana. ¿Quieres que tratemos algún tema concreto? Escríbenos.
          </p>
          <a href="/contacto" class="mt-4 inline-flex items-center gap-2 text-gold-600 font-semibold text-sm hover:text-gold-700">
            Sugerir un tema →
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
