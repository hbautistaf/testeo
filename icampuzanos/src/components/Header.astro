---
const navLinks = [
  { href: '/',               label: 'Inicio' },
  { href: '/servicios',      label: 'Servicios' },
  { href: '/sobre-nosotros', label: 'Sobre nosotros' },
  { href: '/blog',           label: 'Blog' },
  { href: '/contacto',       label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-8 h-8 bg-gold-500 rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-sm font-serif">iC</span>
        </div>
        <span class="font-bold text-lg text-gray-900 group-hover:text-brand-700 transition-colors">
          iCampuzanos
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-6">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={`text-sm font-medium transition-colors hover:text-brand-600 ${
              currentPath === href
                ? 'text-brand-700'
                : 'text-gray-600'
            }`}
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- CTA -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="https://wa.me/524493384115"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 bg-gold-500 hover:bg-gold-600 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.553 4.117 1.524 5.853L.057 23.882l6.194-1.625A11.93 11.93 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.882a9.873 9.873 0 01-5.032-1.374l-.361-.214-3.735.979.995-3.638-.235-.374A9.861 9.861 0 012.118 12C2.118 6.533 6.533 2.118 12 2.118S21.882 6.533 21.882 12 17.467 21.882 12 21.882z"/>
          </svg>
          WhatsApp
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="menu-btn"
        class="md:hidden p-2 rounded-lg text-gray-600 hover:text-brand-700 hover:bg-brand-50 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-2">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-brand-50 hover:text-brand-700 ${
            currentPath === href ? 'bg-brand-50 text-brand-700' : 'text-gray-600'
          }`}
        >
          {label}
        </a>
      ))}
      <a
        href="https://wa.me/524493384115"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 flex items-center justify-center gap-2 bg-gold-500 text-white text-sm font-semibold px-4 py-2 rounded-lg"
      >
        Contactar por WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
